PORT=3001
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173

# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Neon Postgres connection string (see project setup steps)
DATABASE_URL=

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AES-256-GCM key for encrypting Plaid access tokens at rest.
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Plaid credentials (https://dashboard.plaid.com/developers/keys)
# client_id is the same value in both Sandbox and Production; only the secret differs per environment.
PLAID_CLIENT_ID_SANDBOX=
PLAID_CLIENT_ID_PRODUCTION=
PLAID_SECRET=
PLAID_ENV=sandbox
